{
  "name": "@mia-cx/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Design tokens and the Svelte components shared by mia.cx sites.",
  "type": "module",
  "svelte": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tokens.css": "./src/tokens.css",
    "./*.svelte": {
      "types": "./src/*.svelte",
      "svelte": "./src/*.svelte",
      "default": "./src/*.svelte"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@iconify-json/lucide": "^1.2.0",
    "@iconify-json/simple-icons": "^1.2.0",
    "svelte": "^5.0.0",
    "unplugin-icons": "^24.0.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.130",
    "@iconify-json/simple-icons": "^1.2.95",
    "@mia-cx/config": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.3",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
