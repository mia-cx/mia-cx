// The site runs as a Cloudflare Worker. Every page but /cv and /cv.pdf is prerendered and served as
// a static asset. worker.ts runs first for everything outside /_app: it hands agents a page's Markdown
// twin, then passes the rest to SvelteKit's Worker, which serves the assets, renders /cv and /cv.pdf,
// and answers the 404 page.
{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "mia-cx",
    // The mia.cx account, so local tools never have to ask which of a login's accounts to use.
    "account_id": "492214885e7a580ccc1d141dfdb4dc5f",
    "main": "worker.ts",
    "compatibility_date": "2026-09-24",
    // nodejs_compat for @cloudflare/puppeteer, which prints /cv.pdf; it includes AsyncLocalStorage.
    "compatibility_flags": ["nodejs_compat"],
    // Cloudflare Browser Rendering, for /cv.pdf.
    "browser": { "binding": "BROWSER" },
    "routes": [{ "pattern": "mia.cx", "custom_domain": true }],
    // Kept on alongside the domain so branch builds get preview URLs.
    "workers_dev": true,
    "preview_urls": true,
    "assets": {
        "binding": "ASSETS",
        "directory": ".svelte-kit/cloudflare",
        // Pages share their URL with their Markdown twin, so the Worker has to see them first.
        "run_worker_first": ["/*", "!/_app/*"],
    },
    "observability": {
        "enabled": true,
    },
    // Role presets for /cv?role=…, as JSON `{ title, skills? }` per key: `wrangler kv key put --remote
    // --binding CV_PRESETS <role> '<json>'`. Staging reads the same ones.
    "kv_namespaces": [{ "binding": "CV_PRESETS", "id": "d7d079ec11854eb98c655432d1e48b24" }],
    // Narration audio, served at /narration/…. Remote, so `pnpm dev` plays the real bucket too; every
    // environment shares it, since each page's audio is stored under a hash of the text it reads.
    "r2_buckets": [{ "binding": "NARRATION", "bucket_name": "mia-cx-narration", "remote": true }],
    "env": {
        // The `mia-cx-staging` Worker: every push to main lands here before a release reaches mia.cx.
        "staging": {
            "routes": [{ "pattern": "staging.mia.cx", "custom_domain": true }],
            // Bindings don't carry over into an environment.
            "kv_namespaces": [{ "binding": "CV_PRESETS", "id": "d7d079ec11854eb98c655432d1e48b24" }],
            "browser": { "binding": "BROWSER" },
            "r2_buckets": [{ "binding": "NARRATION", "bucket_name": "mia-cx-narration", "remote": true }],
        },
    },
}
