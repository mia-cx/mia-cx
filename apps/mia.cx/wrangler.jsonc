// The site runs as a Cloudflare Worker. Pages are prerendered and served as static assets, except /cv,
// which SvelteKit's Worker renders per request.
// worker.ts runs first for everything outside /_app: it hands agents a page's Markdown twin, then
// passes the rest to SvelteKit's Worker, which serves the assets and answers the 404 page.
{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "mia-cx",
    "main": "worker.ts",
    "compatibility_date": "2026-09-24",
    "compatibility_flags": ["nodejs_als"],
    "routes": [{ "pattern": "mia.cx", "custom_domain": true }],
    // Kept on alongside the domain so branch builds get preview URLs.
    "workers_dev": true,
    "preview_urls": true,
    "assets": {
        "binding": "ASSETS",
        "directory": ".svelte-kit/cloudflare",
        // Pages share their URL with their Markdown twin, so the Worker has to see them first.
        "run_worker_first": ["/*", "!/_app/*"],
    },
    "observability": {
        "enabled": true,
    },
    // Role presets for /cv?role=…, as JSON `{ title, skills? }` per key: `wrangler kv key put --remote
    // --binding CV_PRESETS <role> '<json>'`. Staging reads the same ones.
    "kv_namespaces": [{ "binding": "CV_PRESETS", "id": "d7d079ec11854eb98c655432d1e48b24" }],
    "env": {
        // The `mia-cx-staging` Worker: every push to main lands here before a release reaches mia.cx.
        "staging": {
            "routes": [{ "pattern": "staging.mia.cx", "custom_domain": true }],
            // Bindings don't carry over into an environment.
            "kv_namespaces": [{ "binding": "CV_PRESETS", "id": "d7d079ec11854eb98c655432d1e48b24" }],
        },
    },
}
