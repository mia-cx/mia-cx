# Copy to .env (gitignored) to narrate locally with `pnpm build && pnpm narrate`. CI has the same values
# as the ELEVENLABS_API_KEY secret and ELEVENLABS_VOICE_ID variable.
#
# A restricted ElevenLabs key: Text to Speech (access), User (read), Voices (read).
ELEVENLABS_API_KEY=
# Mia's cloned voice.
ELEVENLABS_VOICE_ID=
# Optional; eleven_v4 when unset.
ELEVENLABS_MODEL_ID=
