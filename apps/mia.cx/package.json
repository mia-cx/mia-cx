{
  "name": "@mia-cx/mia.cx",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm generate:content && vite build",
    "check": "pnpm generate:content && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "dev": "pnpm generate:content && vite dev",
    "dev:host": "pnpm generate:content && vite dev --host",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "preview": "vite preview",
    "test": "npm run test:integration && npm run test:unit",
    "test:integration": "playwright test",
    "test:unit": "vitest run",
    "generate:content": "tsx scripts/generate-content.ts"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.136",
    "@iconify-json/simple-icons": "^1.2.97",
    "@mia-cx/config": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "gray-matter": "^4.0.3",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "5.57.1",
    "svelte-check": "^4.7.6",
    "tslib": "^2.8.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@nanostores/persistent": "^1.3.5",
    "marked": "^18.0.14",
    "@mia-cx/atmosphere": "workspace:*",
    "@mia-cx/ui": "workspace:*"
  }
}
