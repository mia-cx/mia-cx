{
    "name": "@mia-cx/mia.cx",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "pnpm generate:baked && pnpm generate:content && vite build",
        "check": "pnpm generate:content && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "dev": "pnpm generate:content && vite dev",
        "dev:host": "pnpm generate:content && vite dev --host",
        "format": "prettier --write .",
        "lint": "prettier --check . && eslint .",
        "preview": "vite preview",
        "test": "npm run test:integration && npm run test:unit",
        "test:integration": "playwright test",
        "test:unit": "vitest run",
        "generate:baked": "tsx scripts/generate-baked-artifacts.ts",
        "generate:content": "tsx scripts/generate-content.ts"
    },
    "devDependencies": {
        "@iconify-json/lucide": "^1.2.130",
        "@iconify-json/simple-icons": "^1.2.95",
        "@mia-cx/config": "workspace:*",
        "@playwright/test": "^1.44.1",
        "@sveltejs/adapter-auto": "^3.2.2",
        "@sveltejs/adapter-static": "^3.0.10",
        "@sveltejs/kit": "^2.5.17",
        "@sveltejs/vite-plugin-svelte": "^3.1.1",
        "@typescript-eslint/eslint-plugin": "^7.13.1",
        "@typescript-eslint/parser": "^7.13.1",
        "@webgpu/types": "^0.1.66",
        "eslint": "^8.57.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-svelte": "^2.40.0",
        "gray-matter": "^4.0.3",
        "prettier": "^3.3.2",
        "prettier-plugin-svelte": "^3.2.5",
        "svelte": "5.0.0-next.166",
        "svelte-check": "^3.8.1",
        "tslib": "^2.6.3",
        "tsx": "^4.20.6",
        "typescript": "^5.5.2",
        "unplugin-icons": "^23.0.1",
        "vite": "^5.3.1",
        "vitest": "^1.6.0"
    },
    "dependencies": {
        "@fontsource-variable/archivo": "^5.3.0",
        "@nanostores/persistent": "^0.10.2",
        "marked": "^18.0.12"
    }
}
